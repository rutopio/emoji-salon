# Self-hosted font is content-stable (manual woff2, path not hashed) → immutable.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Twemoji SVGs are named by codepoint (not content-hashed) and their content is
# upstream-frozen per Twemoji release → safe to treat as immutable.
/twemoji/*
  Cache-Control: public, max-age=31536000, immutable

# Emoji data JSON can be regenerated at build under the same name → long max-age only.
/data/*
  Cache-Control: public, max-age=604800

# Icons and social image may be regenerated under the same name.
/favicon.ico
  Cache-Control: public, max-age=0, must-revalidate
/social.png
  Cache-Control: public, max-age=604800
